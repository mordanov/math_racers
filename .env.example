# Math Racers — Environment Variable Template
# Copy this file to .env and fill in all values.
# .env is git-ignored and must never be committed.
#
# All secret fields (marked SECRET) must be provided at runtime.
# Never use placeholder values in production.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL credentials — must match POSTGRES_USER/POSTGRES_PASSWORD below
POSTGRES_DB=mathracers
POSTGRES_USER=mathracers
POSTGRES_PASSWORD=mathracers_dev

# PostgreSQL connection string (used by the backend)
# SECRET — never log or expose to client
# For local dev, password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql+asyncpg://mathracers:mathracers_dev@postgres:5432/mathracers

# ─── Cache / Queue ────────────────────────────────────────────────────────────
# Redis connection string
REDIS_URL=redis://redis:6379/0

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET — rotating this value invalidates all active user sessions
JWT_SECRET=CHANGE_ME_32_BYTE_HEX

# JWT access token lifetime in minutes (default: 15)
JWT_ACCESS_TTL_MINUTES=15

# JWT refresh token lifetime in days (default: 30)
JWT_REFRESH_TTL_DAYS=30

# ─── Default Administrator ────────────────────────────────────────────────────
# Credentials for the built-in administrator account seeded at startup.
# If no approved administrator exists, one is created with these credentials.
# SECRET — use strong credentials in all environments.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── AI Provider ──────────────────────────────────────────────────────────────
# OpenAI API key — get from platform.openai.com
# SECRET — never log or expose to client
OPENAI_API_KEY=sk-CHANGE_ME

# ─── Object Storage ───────────────────────────────────────────────────────────
# S3-compatible endpoint (e.g., https://s3.amazonaws.com or Hetzner Object Storage URL)
STORAGE_ENDPOINT=https://CHANGE_ME

# Storage credentials — SECRET
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Bucket name for generated assets
STORAGE_BUCKET=math-racers-assets

# ─── Application ──────────────────────────────────────────────────────────────
# Runtime environment — one of: development, staging, production
ENVIRONMENT=development

# Git SHA of the running image — injected automatically by CI/CD
# Set manually for local dev if needed
VERSION=local

# Log level — one of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
